# Frontend runtime config — copy to .env.local (which is gitignored)

# Browser-side (fetch from React components) — read by Next.js as NEXT_PUBLIC_* env vars
NEXT_PUBLIC_BFF_URL=http://localhost:8081

# Server-side (Next.js route handlers under src/app/api/**/route.ts that proxy to BFF)
BFF_URL=http://localhost:8081

# Feature flags
NEXT_PUBLIC_FEATURE_RUN_COMPARE_ENABLED=true
