# Forge-OH environment variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ---------------------------------------------------------------------------
# BFF server
# Canonical port: 8081
# ---------------------------------------------------------------------------
BFF_PORT=8081
BFF_HOST=0.0.0.0
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# OpenHands agent-server (V1 SDK)
# Canonical port: 8090
# Versions verified against PyPI 2026-08-02 — see BUILD_LOG.md.
# openhands-sdk / openhands-agent-server / openhands-tools / openhands-workspace
# are pinned together at 1.40.0 in the .oh-venv used to run the agent-server.
# ---------------------------------------------------------------------------
OPENHANDS_BASE_URL=http://localhost:8090
OPENHANDS_API_KEY=

# ---------------------------------------------------------------------------
# Local LLM — Ollama (OpenAI-compatible endpoint at /v1)
# The BFF's model_router picks between primary / fast / alt based on task.
# LiteLLM (inside the agent-server) sees these as `openai/<tag>` with
# base_url=OLLAMA_BASE_URL. See bff/services/model_router.py for how the
# Ollama tag is translated into the agent-server LLM config block.
# ---------------------------------------------------------------------------
OLLAMA_URL=http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434/v1

# ---------------------------------------------------------------------------
# Stage 5 memory port (Kosmos vendored adapters)
# EmbeddingsPort (OllamaEmbeddingsAdapter) hits the NATIVE /api/embed endpoint,
# so it consumes OLLAMA_URL (the native root) — NOT OLLAMA_BASE_URL, which is
# the /v1 OpenAI-compat prefix used by the chat model_router.
# VectorPort (QdrantVectorAdapter) connects to the docker-compose qdrant
# service via QDRANT_URL. FORGE_MEMORY_LIVE=1 opts into live-tier Colossus
# contract tests (real Ollama + real Qdrant); leave unset in CI.
# ---------------------------------------------------------------------------
# Forge-OH default: qwen3-embedding:0.6b (1024-dim, ~1.2 GB VRAM, MTEB Code ~73).
# Quality-priority option: qwen3-embedding:4b (2560-dim, ~5 GB VRAM, MTEB Code ~79).
# See ADR-020 for the switch from Kosmos's upstream nomic-embed-text default.
# Both models are pulled on Colossus; swap this to run an A/B comparison.
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
QDRANT_URL=http://localhost:6333
# FORGE_MEMORY_LIVE=1

# Primary — OpenHands-recommended for local/self-hosted (docs.openhands.dev).
# MoE, 3B active params, ~23GB on disk at Q4_K_M.
OLLAMA_PRIMARY_MODEL=qwen3.6:35b-a3b

# Fast — speed-priority fallback (long-context / low-complexity routes).
# MoE, 3B active params.
OLLAMA_FAST_MODEL=qwen3-coder:30b

# Alt — manual higher-quality option (dense, highest verified SWE-bench in
# this VRAM tier). Not resident by default; pull with `ollama pull qwen3.6:27b`
# when needed. Selected via the model router's alt path, not automatic.
OLLAMA_ALT_MODEL=qwen3.6:27b

# ---------------------------------------------------------------------------
# LLM routing
# ---------------------------------------------------------------------------
# Which backend is tried first. "ollama" (default) or "vllm". When "vllm",
# vLLM is probed first and Ollama is the fallback. See
# bff/services/model_router.py for the full policy.
LLM_PRIMARY_BACKEND=ollama

# ---------------------------------------------------------------------------
# vLLM (used as primary when LLM_PRIMARY_BACKEND=vllm, otherwise fallback)
# ---------------------------------------------------------------------------
VLLM_URL=http://localhost:8500
VLLM_FALLBACK_MODEL=qwen3-coder-30b

# ---------------------------------------------------------------------------
# Frontend -> BFF (Next.js)
# Must match BFF_PORT above.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_BFF_URL=http://localhost:8081

# ---------------------------------------------------------------------------
# Observability (optional)
# ---------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
